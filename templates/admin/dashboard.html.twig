{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}👋 Bienvenue,
    {{ app.user.nom|default('Administrateur') }}
{% endblock %}

{% block main %}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-primary text-white shadow-sm">
                <div class="card-body p-4">
                    <h4 class="card-title font-weight-bold">Espace de gestion Eco-Partage</h4>
                    <p class="card-text mb-0 opacity-75">Suivez l'activité de la plateforme, valisez les adhésions et gérez le matériel mis à disposition des membres.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-start border-3 border-info shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase small font-weight-bold">Membres inscrits</h6>
                        <h2 class="font-weight-bold mb-0 text-dark">{{ total_users }}</h2>
                    </div>
                    <div class="bg-info-light text-info p-3 rounded-circle fs-3">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-start border-3 border-success shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase small font-weight-bold">Outils au catalogue</h6>
                        <h2 class="font-weight-bold mb-0 text-dark">{{ total_outils }}</h2>
                    </div>
                    <div class="bg-success-light text-success p-3 rounded-circle fs-3">
                        <i class="fas fa-tools"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-start border-3 border-warning shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase small font-weight-bold">Emprunts en cours</h6>
                        <h2 class="font-weight-bold mb-0 text-dark">{{ outils_empruntes }}</h2>
                    </div>
                    <div class="bg-warning-light text-warning p-3 rounded-circle fs-3">
                        <i class="fas fa-hand-holding"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-start border-3 border-danger shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase small font-weight-bold">Retards en cours</h6>
                        <h2 class="font-weight-bold mb-0 text-danger">{{ emprunts_retard|length }}</h2>
                    </div>
                    <div class="bg-danger-light text-danger p-3 rounded-circle fs-3">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# 📊 SECTION DES GRAPHIQUES #}
    <div class="row g-4 mb-4">
        {# Graphique 1 : Volume mensuel des emprunts #}
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="card-title font-weight-bold text-dark mb-3">
                        <i class="fas fa-chart-line me-2 text-success"></i>
                        Volume mensuel des emprunts (Année en cours)
                    </h5>
                    <div style="height: 280px; position: relative;">
                        <canvas id="empruntChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        {# Graphique 2 : Top 5 des outils les plus empruntés #}
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="card-title font-weight-bold text-dark mb-3">
                        <i class="fas fa-trophy me-2 text-warning"></i>
                        Top 5 des outils empruntés
                    </h5>
                    <div style="height: 280px; position: relative;">
                        <canvas id="topOutilsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        {# Graphique 3 : Répartition des outils par catégorie #}
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="card-title font-weight-bold text-dark mb-3">
                        <i class="fas fa-chart-pie me-2 text-info"></i>
                        Répartition des outils par catégorie
                    </h5>
                    <div style="height: 280px; position: relative;">
                        <canvas id="catChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# 🚨 SECTION : MATÉRIEL EN RETARD NON RESTITUÉ #}
    {% if emprunts_retard|length > 0 %}
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-danger shadow-sm">
                    <div class="card-header bg-danger text-white d-flex align-items-center">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <h5 class="mb-0">Matériel en retard non restitué ({{ emprunts_retard|length }})</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Outil</th>
                                        <th>Emprunteur</th>
                                        <th>Prévu le</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for retard in emprunts_retard %}
                                        <tr>
                                            <td>
                                                <strong>{{ retard.outil.nom }}</strong>
                                            </td>
                                            <td>{{ retard.user.email }}</td>
                                            <td class="text-danger fw-bold">
                                                {{ retard.dateRetourPrevue ? retard.dateRetourPrevue|date('d/m/Y') : 'N/A' }}
                                            </td>
                                            <td class="text-end">
                                                <a href="{{ path('admin_relancer_outil', {id: retard.outil.id}) }}" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-paper-plane me-1"></i>
                                                    Relancer par e-mail
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# 📋 SECTION : DERNIERS EMPRUNTS #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h5 class="card-title font-weight-bold text-dark mb-3">
                        <i class="fas fa-history me-2 text-primary"></i>
                        Derniers emprunts de la plateforme
                    </h5>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Outil</th>
                                    <th>Membre</th>
                                    <th>Date d'emprunt</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for historique in derniers_emprunts %}
                                    <tr>
                                        <td>
                                            <i class="fas fa-tools text-secondary me-2"></i>
                                            <strong>{{ historique.outil.nom }}</strong>
                                        </td>
                                        <td>
                                            <i class="fas fa-user text-muted me-2"></i>
                                            {{ historique.user.email }}
                                        </td>
                                        <td>
                                            {{ historique.dateDebut ? historique.dateDebut|date('d/m/Y H:i') : 'N/A' }}
                                        </td>
                                        <td>
                                            {% if historique.dateFin is null %}
                                                <span class="badge bg-warning text-dark">En cours</span>
                                            {% else %}
                                                <span class="badge bg-success">Terminé</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">Aucun emprunt récent enregistré.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light font-weight-bold">
                    <i class="fas fa-bolt me-2 text-warning"></i>
                    Actions rapides de modération
                </div>
                <div class="card-body">
                    <p class="text-muted small">Accédez directement aux sections clés pour administrer la plateforme :</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').setAction('index') }}" class="btn btn-outline-info">
                            <i class="fas fa-user-shield me-2"></i>
                            Modérer un utilisateur / Bloquer un compte
                        </a>
                        <a href="{{ ea_url().setController('App\\Controller\\Admin\\OutilCrudController').setAction('new') }}" class="btn btn-outline-success">
                            <i class="fas fa-plus me-2"></i>
                            Ajouter un nouvel outil au catalogue
                        </a>
                        <a href="{{ ea_url().setController('App\\Controller\\Admin\\OutilCrudController').setAction('index') }}" class="btn btn-outline-warning">
                            <i class="fas fa-undo me-2"></i>
                            Forcer le retour d'un matériel
                        </a>
                        <a href="{{ path('app_home') }}" class="btn btn-success shadow-sm px-3 py-2 text-white">
                            <i class="fas fa-eye me-2"></i>
                            Voir le site (Côté public)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Styles d'appoint #}
    <style>
        .bg-info-light { background-color: rgba(13, 202, 240, 0.15); }
        .bg-success-light { background-color: rgba(25, 135, 84, 0.15); }
        .bg-warning-light { background-color: rgba(255, 193, 7, 0.15); }
        .bg-danger-light { background-color: rgba(220, 53, 69, 0.15); }
        .gap-2 { gap: 0.5rem !important; }
        .opacity-75 { opacity: 0.75; }
    </style>

    {# Scripts Chart.js #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Graphique d'évolution mensuelle (Ligne)
            const ctxEmprunt = document.getElementById('empruntChart').getContext('2d');
            const dbData = {{ stats_emprunts|raw }};
            const labels = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];

            new Chart(ctxEmprunt, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Nombre d\'emprunts',
                        data: dbData,
                        borderColor: '#198754',
                        backgroundColor: 'rgba(25, 135, 84, 0.08)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#198754',
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1, color: '#6c757d' },
                            grid: { color: '#f1f3f5' }
                        },
                        x: {
                            ticks: { color: '#6c757d' },
                            grid: { display: false }
                        }
                    },
                    plugins: { legend: { display: false } }
                }
            });

            // 2. Graphique du Top Outils (Barres)
            const ctxTop = document.getElementById('topOutilsChart').getContext('2d');
            const topLabels = {{ top_outils_labels|raw }};
            const topData = {{ top_outils_data|raw }};

            new Chart(ctxTop, {
                type: 'bar',
                data: {
                    labels: topLabels,
                    datasets: [{
                        label: 'Emprunts',
                        data: topData,
                        backgroundColor: [
                            'rgba(25, 135, 84, 0.7)',
                            'rgba(13, 202, 240, 0.7)',
                            'rgba(255, 193, 7, 0.7)',
                            'rgba(220, 53, 69, 0.7)',
                            'rgba(111, 66, 193, 0.7)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1, color: '#6c757d' },
                            grid: { color: '#f1f3f5' }
                        },
                        x: {
                            ticks: { color: '#6c757d' },
                            grid: { display: false }
                        }
                    },
                    plugins: { legend: { display: false } }
                }
            });

            // 3. Graphique de répartition par catégorie (Camembert / Pie) - Couleurs BDD
            const ctxCat = document.getElementById('catChart').getContext('2d');
            const catLabels = {{ cat_labels|raw }};
            const catData = {{ cat_data|raw }};
            const catColors = {{ cat_colors|raw }}; // <-- Récupération des couleurs fixes de la BDD

            new Chart(ctxCat, {
                type: 'pie',
                data: {
                    labels: catLabels,
                    datasets: [{
                        data: catData,
                        backgroundColor: catColors, // <-- Application des couleurs synchronisées
                        borderWidth: 1,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                padding: 15
                            }
                        }
                    }
                }
            });
        });
    </script>
{% endblock %}
