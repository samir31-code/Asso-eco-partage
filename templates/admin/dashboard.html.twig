{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}👋 Bienvenue, {{ app.user.nom|default('Administrateur') }}{% endblock %}

{% block main %}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-primary text-white shadow-sm">
                <div class="card-body p-4">
                    <h4 class="card-title font-weight-bold">Espace de gestion Eco-Partage</h4>
                    <p class="card-text mb-0 opacity-75">Suivez l'activité de la plateforme, validez les adhésions et gérez le matériel mis à disposition des membres.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card border-start border-3 border-info shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase small font-weight-bold">Membres inscrits</h6>
                        <h2 class="font-weight-bold mb-0 text-dark">{{ total_users }}</h2>
                    </div>
                    <div class="bg-info-light text-info p-3 rounded-circle fs-3">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card border-start border-3 border-success shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase small font-weight-bold">Outils au catalogue</h6>
                        <h2 class="font-weight-bold mb-0 text-dark">{{ total_outils }}</h2>
                    </div>
                    <div class="bg-success-light text-success p-3 rounded-circle fs-3">
                        <i class="fas fa-tools"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card border-start border-3 border-warning shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase small font-weight-bold">Emprunts en cours</h6>
                        <h2 class="font-weight-bold mb-0 text-dark">{{ outils_empruntes }}</h2>
                    </div>
                    <div class="bg-warning-light text-warning p-3 rounded-circle fs-3">
                        <i class="fas fa-hand-holding"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light font-weight-bold">
                    <i class="fas fa-bolt me-2 text-warning"></i> Actions rapides de modération
                </div>
                <div class="card-body">
                    <p class="text-muted small">Accédez directement aux sections clés pour administrer la plateforme :</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="{{ url_users }}" class="btn btn-outline-info">
                            <i class="fas fa-user-shield me-2"></i> Modérer un utilisateur / Bloquer un compte
                        </a>
                        <a href="{{ url_outils }}" class="btn btn-outline-success">
                            <i class="fas fa-plus me-2"></i> Ajouter un nouvel outil au catalogue
                        </a>
                        <a href="{{ url_outils }}" class="btn btn-outline-warning">
                            <i class="fas fa-undo me-2"></i> Forcer le retour d'un matériel
                        </a>
                        <a href="/" class="btn btn-secondary text-white">
                            <i class="fas fa-eye me-2"></i> Voir le site (Côté public)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Quelques styles d'appoint pour rendre les fonds d'icônes plus doux #}
    <style>
        .bg-info-light { background-color: rgba(13, 202, 240, 0.15); }
        .bg-success-light { background-color: rgba(25, 135, 84, 0.15); }
        .bg-warning-light { background-color: rgba(255, 193, 7, 0.15); }
        .gap-2 { gap: 0.5rem !important; }
        .opacity-75 { opacity: 0.75; }
    </style>
{% endblock %}
