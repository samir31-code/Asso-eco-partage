{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Eco-Partage
{% endblock %}

{% block body %}
	<div
		class="row">
		{# 👤 En-tête Profil #}
		<div class="col-12 mb-4">
			<div class="bg-dark text-white p-4 rounded shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-3">
				<div>
					<h1 class="h3 mb-1">👤 Espace Personnel</h1>
					<p class="mb-0 text-muted">Ravi de vous revoir,
						<strong class="text-white">{{ app.user.prenom }}
							{{ app.user.nom }}</strong>
					</p>
				</div>
				<div>
					<span class="badge {{ 'ROLE_MEMBRE' in app.user.roles ? 'bg-success' : 'bg-warning text-dark' }} px-3 py-2 fs-6">
						{{ 'ROLE_MEMBRE' in app.user.roles ? '⚡ Membre Actif (Cotisé)' : '🛑 Cotisation en attente' }}
					</span>
				</div>
			</div>
		</div>

		{# 🔄 SECTION 1 : Emprunts en cours #}
		<div class="col-12 mb-5">
			<h2 class="h4 fw-bold text-dark mb-3">📦 Mes emprunts en cours</h2>
			{% if empruntsEnCours is empty %}
				<div class="alert alert-light border text-center py-4 shadow-sm mb-0">
					<span class="text-muted">Vous n'avez aucun outil emprunté pour le moment. Visitez le
						<a href="{{ path('app_outil_index') }}" class="fw-bold text-info">catalogue</a>
						pour vous équiper !</span>
				</div>
			{% else %}
				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
					{% for historique in empruntsEnCours %}
						<div class="col">
							<div class="card h-100 shadow-sm border-start border-warning border-4">
								<div class="card-body d-flex flex-column">
									<h5 class="card-title fw-bold text-dark mb-1">{{ historique.outil.nom }}</h5>
									<span class="badge bg-secondary align-self-start mb-2">{{ historique.outil.categorie }}</span>
									<p class="text-muted small mb-3">Emprunté le
										{{ historique.dateDebut|date('d/m/Y à H:i') }}</p>

									<div class="mt-auto pt-3 border-top d-flex gap-2">
										<a href="{{ path('app_outil_show', {'id': historique.outil.id}) }}" class="btn btn-outline-info btn-sm flex-grow-1">Détails</a>
										<a href="{{ path('app_outil_rendre', {'id': historique.outil.id}) }}" class="btn btn-warning text-dark fw-bold btn-sm flex-grow-1">🤝 Rendre</a>
									</div>
								</div>
							</div>
						</div>
					{% endfor %}
				</div>
			{% endif %}
		</div>

		{# 🛠️ NOUVELLE SECTION : Mes outils mis en partage #}
		<div class="col-12 mb-5">
			<div class="d-flex justify-content-between align-items-center mb-3">
				<h2 class="h4 fw-bold text-dark m-0">🛠️ Mes outils mis en partage</h2>
				<a href="{{ path('app_outil_new') }}" class="btn btn-sm btn-outline-primary">➕ Ajouter un outil</a>
			</div>

			{% if mesOutils is empty %}
				<div class="alert alert-light border text-center py-4 shadow-sm mb-0">
					<span class="text-muted">Vous n'avez pas encore proposé d'outils au catalogue.</span>
				</div>
			{% else %}
				<div class="card border-0 shadow-sm bg-white">
					<div class="table-responsive">
						<table class="table table-hover align-middle mb-0">
							<thead class="table-light">
								<tr>
									<th>Nom de l'outil</th>
									<th>Catégorie</th>
									<th>Statut actuel</th>
									<th class="text-end">Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for outil in mesOutils %}
									<tr>
										<td>
											<span class="fw-bold text-dark">{{ outil.nom }}</span>
										</td>
										<td>
											<span class="badge bg-secondary">{{ outil.categorie }}</span>
										</td>
										<td>
											{% if outil.emprunteur %}
												<span class="badge bg-danger shadow-sm">❌ Emprunté par
													{{ outil.emprunteur.prenom }}</span>
											{% else %}
												<span class="badge bg-success shadow-sm">✅ Disponible</span>
											{% endif %}
										</td>
										<td class="text-end">
											<a href="{{ path('app_outil_show', {'id': outil.id}) }}" class="btn btn-sm btn-light border">Voir</a>
											<a href="{{ path('app_outil_edit', {'id': outil.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			{% endif %}
		</div>

		{# 📊 SECTION 2 : Historique des partages #}
		<div class="col-12">
			<h2 class="h4 fw-bold text-dark mb-3">📜 Mon historique de locations</h2>
			{% if empruntsTermines is empty %}
				<div class="alert alert-light border text-center py-4 shadow-sm">
					<span class="text-muted">Aucun historique d'emprunt disponible.</span>
				</div>
			{% else %}
				<div class="card border-0 shadow-sm bg-white">
					<div class="table-responsive">
						<table class="table table-hover align-middle mb-0">
							<thead class="table-light">
								<tr>
									<th>Outil</th>
									<th>Période</th>
									<th>Ma Note</th>
									<th>Mon Commentaire</th>
								</tr>
							</thead>
							<tbody>
								{% for h in empruntsTermines %}
									<tr>
										<td>
											<span class="fw-bold text-dark">{{ h.outil.nom }}</span>
											<br><small class="text-muted">{{ h.outil.categorie }}</small>
										</td>
										<td class="small text-secondary">
											Du
											{{ h.dateDebut|date('d/m/Y') }}
											au
											{{ h.dateFin|date('d/m/Y') }}
										</td>
										<td>
											{% if h.note is not null %}
												<span class="text-warning">
													{% for i in 1..h.note %}
														<i class="fa-solid fa-star small"></i>
													{% endfor %}
												</span>
											{% else %}
												<span class="text-muted small italic">Pas de note</span>
											{% endif %}
										</td>
										<td class="text-secondary small italic">
											{{ h.commentaire ?: '<span class="text-muted opacity-50">Aucun texte laissé</span>'|raw }}
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}
