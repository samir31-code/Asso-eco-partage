{% extends 'base.html.twig' %}

{% block title %}Mon Espace Profil - Eco-Partage
{% endblock %}

{% block body %}
	<div class="container mt-4">
		<h1 class="h2 text-dark mb-4">👤 Mon Tableau de Bord</h1>

		<div
			class="row g-4">
			{# 📋 COLONNE GAUCHE : Informations personnelles & Cotisation #}
			<div class="col-lg-4">
				<div class="card shadow-sm border-0 bg-white p-4 text-center">
					<div class="mx-auto bg-light rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
						<span class="fs-2">👤</span>
					</div>
					<h2 class="h4 fw-bold text-dark m-0">{{ user.prenom }}
						{{ user.nom|upper }}</h2>
					<p class="text-muted small mb-3">{{ user.email }}</p>

					<hr>

					{# Statut Stripe / Cotisation #}
					<div class="mt-3">
						<h6 class="text-secondary fw-bold small text-uppercase">Statut Cotisation</h6>
						{% if is_granted('ROLE_MEMBRE') %}
							<div class="badge bg-success-subtle text-success p-2 w-100 rounded border border-success border-opacity-25 fs-6">
								✅ Membre Actif (Cotisation OK)
							</div>
						{% else %}
							<div class="badge bg-warning-subtle text-warning-emphasis p-2 w-100 rounded border border-warning border-opacity-25 fs-6 mb-2">
								⚠️ Cotisation non réglée
							</div>
							<a href="{{ path('app_cotisation_paiement') }}" class="btn btn-warning btn-sm w-100 fw-bold text-dark">
								💳 Régler ma cotisation (15€)
							</a>
						{% endif %}
					</div>
				</div>
			</div>

			{# 🛠️ COLONNE DROITE : Listes des Outils et Emprunts #}
			<div
				class="col-lg-8">

				{# SECTION A : Mes Emprunts Actuels #}
				<div class="card shadow-sm border-0 bg-white p-4 mb-4">
					<h3 class="h5 fw-bold text-dark border-bottom pb-2 mb-3">🔑 Matériel que j'emprunte actuellement</h3>

					{% if user.emprunts is not empty %}
						<div class="table-responsive">
							<table class="table align-middle">
								<thead>
									<tr class="table-light">
										<th>Outil</th>
										<th>Catégorie</th>
										<th>Propriétaire</th>
										<th class="text-end">Action</th>
									</tr>
								</thead>
								<tbody>
									{% for emprunt in user.emprunts %}
										<tr>
											<td class="fw-bold">{{ emprunt.nom }}</td>
											<td>
												<span class="badge bg-secondary">{{ emprunt.categorie }}</span>
											</td>
											<td class="small">👤
												{{ emprunt.proprietaire.prenom }}</td>
											<td class="text-end">
												<form action="{{ path('app_outil_rendre', {'id': emprunt.id}) }}" method="POST" class="d-inline">
													<input type="hidden" name="_token" value="{{ csrf_token('rendre' ~ emprunt.id) }}">
													<a href="{{ path('app_outil_rendre', {'id': emprunt.id}) }}" class="btn btn-warning btn-sm">
														📦 Rendre l'outil
													</a>
												</form>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% else %}
						<p class="text-muted small my-3">Vous n'avez aucun emprunt en cours. Visitez le
							<a href="{{ path('app_outil_index') }}">catalogue</a>
							pour vous équiper !</p>
					{% endif %}
				</div>

				{# SECTION B : Mes Outils mis à disposition #}
				<div class="card shadow-sm border-0 bg-white p-4">
					<div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
						<h3 class="h5 fw-bold text-dark m-0">🤝 Mes outils partagés avec l'association</h3>
						<a href="{{ path('app_outil_new') }}" class="btn btn-outline-primary btn-sm">➕ Ajouter</a>
					</div>

					{% if user.outils is not empty %}
						<div class="table-responsive">
							<table class="table align-middle">
								<thead>
									<tr class="table-light">
										<th>Outil</th>
										<th>Catégorie</th>
										<th>Statut d'utilisation</th>
										<th class="text-end">Fiche</th>
									</tr>
								</thead>
								<tbody>
									{# 🔄 Correction ici aussi : for au lieu de foreach #}
									{% for outil in user.outils %}
										<tr>
											<td class="fw-bold">{{ outil.nom }}</td>
											<td>
												<span class="badge bg-light text-dark border">{{ outil.categorie }}</span>
											</td>
											<td>
												{% if outil.emprunteur %}
													<span class="badge bg-danger-subtle text-danger border border-danger border-opacity-25">
														🔄 Emprunté par
														{{ outil.emprunteur.prenom }}
													</span>
												{% else %}
													<span class="badge bg-success-subtle text-success border border-success border-opacity-25">
														✅ Disponible au local
													</span>
												{% endif %}
											</td>
											<td class="text-end">
												<a href="{{ path('app_outil_show', {'id': outil.id}) }}" class="btn btn-light btn-sm fw-bold">Voir</a>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% else %}
						<p class="text-muted small my-3">Vous n'avez pas encore proposé de matériel à la communauté.</p>
					{% endif %}
				</div>

				{# SECTION C : Mon Historique d'Emprunts (Terminés) #}
				<div class="card shadow-sm border-0 bg-white p-4 mt-4">
					<h3 class="h5 fw-bold text-dark border-bottom pb-2 mb-3">📜 Mon historique d'emprunts</h3>

					{% if user.historiques is not empty %}
						<div class="table-responsive">
							<table class="table align-middle table-sm">
								<thead>
									<tr class="table-light">
										<th>Outil</th>
										<th>Emprunté le</th>
										<th>Rendu le</th>
									</tr>
								</thead>
								<tbody>
									{% for hist in user.historiques %}
										<tr>
											<td class="fw-bold">{{ hist.outil.nom }}</td>
											<td class="small text-muted">
												{{ hist.dateDebut|date('d/m/Y à H:i') }}
											</td>
											<td class="small">
												{% if hist.dateFin %}
													<span class="badge bg-success-subtle text-success d-block mb-1">
														Rendu le
														{{ hist.dateFin|date('d/m/Y à H:i') }}
													</span>
													{% if hist.note %}
														<div class="text-warning font-monospace">
															{% for i in 1..hist.note %}⭐
															{% endfor %}
														</div>
														{% if hist.commentaire %}
															<small class="text-muted d-block italic">"{{ hist.commentaire }}"</small>
														{% endif %}
													{% endif %}
												{% else %}
													<span class="badge bg-warning-subtle text-warning">En cours d'emprunt</span>
												{% endif %}
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% else %}
						<p class="text-muted small my-3">Aucun historique d'emprunt disponible.</p>
					{% endif %}
				</div>>
			</div>
		</div>
	</div>
{% endblock %}
