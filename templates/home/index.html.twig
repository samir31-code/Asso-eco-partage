{% extends 'base.html.twig' %}

{% block title %}Accueil - Eco-Partage
{% endblock %}

{% block body %}

    {# 👑 BANDEAU D'ACCÈS RAPIDE À LA CONSOLE ADMIN #}
    {# S'affiche uniquement si Sam (ROLE_ADMIN) est connecté #}
        {% if is_granted('ROLE_ADMIN') %}
            <div class="alert alert-danger d-flex align-items-center justify-content-between shadow-sm mb-4 border-0 rounded-3" role="alert"> <div class="d-flex align-items-center">
                <span class="fs-4 me-3">🛡️</span>
                <div>
                    <strong class="text-danger">Mode Administrateur Activé</strong>
                    <span class="d-none d-md-inline text-muted">
                        — Vous avez les pleins pouvoirs de gestion (A-Z) sur les utilisateurs, les outils et l'activité.</span>
                </div>
            </div>
            {# Utilisation de la bonne route d'accès au dashboard #}
            <a href="/admin" class="btn btn-danger btn-sm fw-bold">
                <i class="fas fa-cog me-1"></i>
                Ouvrir la Console Admin
            </a>
        </div>
    {% endif %}

    {# 🌟 Section Hero : Présentation percutante #}
    <div class="p-5 mb-5 bg-light rounded-4 shadow-sm border-0 position-relative overflow-hidden" style="background: linear-gradient(135deg, #e3f2fd 0%, #ffffff 100%);">
        <div class="container-fluid py-4">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <span class="badge bg-info text-dark fw-bold px-3 py-2 rounded-pill mb-3">🌱 Économie Collaborative & Solidaire</span>
                    <h1 class="display-4 fw-bold text-dark mb-3">Ne possédez plus,<br><span class="text-success">partagez vos outils !</span>
                    </h1>
                    <p class="col-md-10 fs-5 text-muted mb-4">
                        Bienvenue sur
                        <strong>Eco-Partage</strong>. Notre plateforme vous permet d'emprunter et de prêter facilement du matériel de bricolage, de jardinage ou d'entretien entre voisins de manière sécurisée et éco-responsable.
                    </p>

                    <div class="d-flex gap-3 flex-wrap">
                        <a href="{{ path('app_outil_index') }}" class="btn btn-success btn-lg px-4 shadow-sm fw-bold">
                            📦 Parcourir le catalogue
                        </a>

                        {% if not app.user %}
                            <a href="{{ path('app_register') }}" class="btn btn-outline-dark btn-lg px-4">
                                Créer un compte
                            </a>
                        {% else %}
                            <a href="{{ path('app_outil_new') }}" class="btn btn-outline-primary btn-lg px-4">
                                ➕ Proposer un outil
                            </a>
                        {% endif %}
                    </div>
                </div>

                {# Illustration visuelle discrète à droite #}
                <div class="col-lg-5 d-none d-lg-flex justify-content-center">
                    <div class="text-center p-4 bg-white rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 280px; height: 280px;">
                        <div class="display-1">🛠️🌿🏡</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# 🎡 SECTION CARROUSEL : LES DERNIERS OUTILS DU CATALOGUE #}
    <div class="card shadow-sm border-0 bg-white p-4 rounded-4 mb-5">
        <h2 class="h4 fw-bold text-dark mb-4 text-center text-md-start">✨ Récemment ajoutés sur la plateforme</h2>

        {% if derniers_outils is defined and derniers_outils is not empty %}
            <div id="carouselHomeOutils" class="carousel slide carousel-dark" data-bs-ride="carousel">
                <div
                    class="carousel-inner px-md-5">

                    {# Découpage des outils par paquets de 3 avec le filtre batch #}
                    {% for groupe in derniers_outils|batch(3) %}
                        <div class="carousel-item {% if loop.first %}active{% endif %}">
                            <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">

                                {% for outil in groupe %}
                                    <div class="col">
                                        <div
                                            class="card h-100 border bg-light shadow-none rounded-3 overflow-hidden position-relative transition-card">

                                            {# Badge de statut à la volée #}
                                            <span class="position-absolute top-0 end-0 m-2 badge {% if outil.emprunteur %}bg-danger{% else %}bg-success{% endif %}" style="z-index: 2;">
                                                {% if outil.emprunteur %}Emprunté{% else %}Disponible
                                                {% endif %}
                                            </span>

                                            {# Zone image de l'outil (Support relation photos ET ancien champ image) #}
                                            <div class="bg-white d-flex align-items-center justify-content-center border-bottom" style="height: 140px;">
                                                {% if outil.photos is defined and outil.photos is not empty %}
                                                    <img src="{{ asset('uploads/outils/' ~ outil.photos|first.nom) }}" class="img-fluid h-100 p-2" alt="{{ outil.nom }}" style="object-fit: contain;">
                                                {% elseif outil.image is defined and outil.image %}
                                                    <img src="{{ asset('uploads/outils/' ~ outil.image) }}" class="img-fluid h-100 p-2" alt="{{ outil.nom }}" style="object-fit: contain;">
                                                {% else %}
                                                    <i class="fas fa-tools text-muted opacity-50 fs-3"></i>
                                                {% endif %}
                                            </div>

                                            {# Détails simplifiés #}
                                            <div class="card-body p-3 d-flex flex-column">
                                                <span class="text-muted small fw-semibold text-uppercase mb-1" style="font-size: 0.7rem;">
                                                    {{ outil.categorie ? outil.categorie.nom : 'Sans catégorie' }}
                                                </span>
                                                <h5 class="card-title h6 text-dark fw-bold mb-2 text-truncate">{{ outil.nom }}</h5>

                                                <a href="{{ path('app_outil_show', {'id': outil.id}) }}" class="btn btn-sm btn-outline-success mt-auto rounded-pill fw-bold">
                                                    Découvrir
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}

                            </div>
                        </div>
                    {% endfor %}

                </div>

                {# Flèches de contrôles latérales positionnées proprement #}
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselHomeOutils" data-bs-slide="prev" style="width: 5%;">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Précédent</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselHomeOutils" data-bs-slide="next" style="width: 5%;">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Suivant</span>
                </button>
            </div>
        {% else %}
            <p class="text-muted text-center mb-0 small italic py-3">📦 Aucun matériel n'est disponible pour le moment. Rejoignez l'aventure en ajoutant le premier !</p>
        {% endif %}
    </div>

    {# 🛠️ Section Fonctionnalités : Comment ça marche ? #}
    <div class="row g-4 text-center my-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 bg-transparent p-3">
                <div class="mx-auto bg-success bg-opacity-10 text-success rounded-circle p-3 mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <span class="fs-3">💳</span>
                </div>
                <h3 class="h5 fw-bold text-dark">1. Cotisez en ligne</h3>

                {% if is_granted('ROLE_ADMIN') %}
                    <p class="text-success small fw-bold">🛡️ En tant qu'administrateur, votre accès est total et gratuit de manière permanente.</p>
                {% else %}
                    <p class="text-muted small">Réglez votre cotisation annuelle de 15,00 € de manière totalement sécurisée via notre intégration Stripe.</p>
                {% endif %}
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 bg-transparent p-3">
                <div class="mx-auto bg-info bg-opacity-10 text-info rounded-circle p-3 mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <span class="fs-3">🔍</span>
                </div>
                <h3 class="h5 fw-bold text-dark">2. Choisissez votre outil</h3>
                <p class="text-muted small">Naviguez à travers notre catalogue filtré par catégorie et trouvez instantanément le matériel qu'il vous faut.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 bg-transparent p-3">
                <div class="mx-auto bg-primary bg-opacity-10 text-primary rounded-circle p-3 mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <span class="fs-3">🔑</span>
                </div>
                <h3 class="h5 fw-bold text-dark">3. Empruntez & Partagez</h3>
                <p class="text-muted small">Réservez en un clic, récupérez l'outil auprès de son propriétaire, et rendez-le une fois vos travaux terminés !</p>
            </div>
        </div>
    </div>

    <style>
        .transition-card {
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        .transition-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
        }
        #carouselHomeOutils .carousel-control-prev {
            left: -12px;
        }
        #carouselHomeOutils .carousel-control-next {
            right: -12px;
        }
    </style>
{% endblock %}
