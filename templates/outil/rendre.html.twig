{% extends 'base.html.twig' %}

{% block title %}Restitution de l'outil - Eco-Partage{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="card shadow p-4 bg-white rounded" style="max-width: 600px; width: 100%;">
            <h2 class="h4 fw-bold mb-3">🤝 Restitution de l'outil</h2>
            <p>Vous êtes sur le point de rendre l'outil
                <strong>{{ outil.nom }}</strong>
                à son propriétaire.</p>
            <p class="text-muted small">Pour maintenir la confiance au sein de la communauté, merci de laisser un avis sur cette expérience.</p>

            {{ form_start(form) }}

            {# 🌟 Zone de notation par étoiles #}
            <div class="mb-4 text-center">
                <label class="form-label fw-semibold text-dark d-block text-start">Note sur 5</label>

                <div class="rating">
                    <input type="radio" id="star5" name="note" value="5" required />
                    <label for="star5" title="5 étoiles">★</label>

                    <input type="radio" id="star4" name="note" value="4" />
                    <label for="star4" title="4 étoiles">★</label>

                    <input type="radio" id="star3" name="note" value="3" />
                    <label for="star3" title="3 étoiles">★</label>

                    <input type="radio" id="star2" name="note" value="2" />
                    <label for="star2" title="2 étoiles">★</label>

                    <input type="radio" id="star1" name="note" value="1" />
                    <label for="star1" title="1 étoile">★</label>
                </div>

                {# On masque le champ Symfony d'origine #}
                {% do form.note.setRendered %}
            </div>

            <div class="mb-4">
                {{ form_row(form.commentaire, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Ex: L\'outil fonctionne super bien ou rendu propre et à l\'heure...'}}) }}
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a href="{{ path('app_profil') }}" class="btn btn-outline-secondary">Annuler</a>
                <button type="submit" class="btn btn-success fw-bold px-4">Valider le rendu et l'avis</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>

    {# 🎨 Styles optimisés pour l'accessibilité #}
    <style>
        .rating {
            display: inline-flex;
            flex-direction: row-reverse; /* Aligne de 1 à droite à 5 à gauche visuellement */
            justify-content: center;
        }

        /* Masquage propre et accessible des boutons radio */
        .rating input {
            position: absolute;
            width: 1px;
            height: 1px;
            margin: -1px;
            padding: 0;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            border: 0;
        }

        /* Style des étoiles par défaut */
        .rating label {
            color: #ccc;
            font-size: 35px;
            padding: 0 4px;
            cursor: pointer;
            transition: color 0.15s ease-in-out;
        }

        /* Allumage au survol et au clic (Jaune) */
        .rating input:checked ~ label,
        .rating label:hover,
        .rating label:hover ~ label {
            color: #ffc107;
        }
    </style>
{% endblock %}
