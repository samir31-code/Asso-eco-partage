{% extends 'base.html.twig' %}

{% block title %}Catalogue des Outils - Eco-Partage{% endblock %}

{% block body %}

    {% if app.user %}
        <div class="alert alert-success shadow-sm mb-4" role="alert">
            💡 Ravie de vous revoir, <strong>{{ app.user.prenom }}</strong> ! 👋
        </div>
    {% else %}
        <div class="alert alert-primary shadow-sm mb-4" role="alert">
            👋 <strong>Bienvenue sur Eco-Partage !</strong> Connectez-vous pour commencer à ajouter ou emprunter des outils.
        </div>
    {% endif %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 text-dark m-0">📦 Catalogue des outils</h1>
        <a href="{{ path('app_outil_new') }}" class="btn btn-primary">➕ Ajouter un outil</a>
    </div>

    {# 🧭 Barre de Filtres Express #}
    <div class="bg-light p-3 rounded shadow-sm mb-4 d-flex align-items-center gap-2 flex-wrap">
        <span class="fw-bold text-secondary me-2">📁 Filtrer par :</span>
        <button class="btn btn-sm btn-dark px-3 rounded-pill filter-btn" data-category="all">Tout voir</button>

        {# Extraction dynamique des catégories présentes dans ta liste #}
        {% set categories = [] %}
        {% for o in outils %}
            {% if o.categorie not in categories %}
                {% set categories = categories | merge([o.categorie]) %}
            {% endif %}
        {% endfor %}

        {% for cat in categories %}
            <button class="btn btn-sm btn-outline-dark px-3 rounded-pill filter-btn" data-category="{{ cat|lower|replace({' ': '-'}) }}">{{ cat }}</button>
        {% endfor %}
    </div>

    {# 📦 Grille de cartes Bootstrap #}
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        {% for outil in outils %}
            <div class="col outil-card" data-cat="{{ outil.categorie|lower|replace({' ': '-'}) }}">
                <div class="card h-100 shadow-sm border-0 bg-white position-relative">

                    {# Badge de Statut #}
                    <div class="position-absolute top-0 end-0 m-3">
                        {% if outil.emprunteur %}
                            <span class="badge bg-danger shadow">❌ Emprunté</span>
                        {% else %}
                            <span class="badge bg-success shadow">✅ Disponible</span>
                        {% endif %}
                    </div>

                    {# Image de l'outil #}
                    {% if outil.image %}
                        <img src="{{ outil.image }}" class="card-img-top" alt="{{ outil.nom }}" style="height: 200px; object-fit: cover;">
                    {% else %}
                        <div class="bg-light text-muted d-flex align-items-center justify-content-center card-img-top" style="height: 200px;">
                            <span class="small">Pas d'image disponible</span>
                        </div>
                    {% endif %}

                    {# Corps de la carte #}
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2 align-self-start">{{ outil.categorie }}</span>
                        <h5 class="card-title text-dark fw-bold mb-2">{{ outil.nom }}</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            {{ outil.description|slice(0, 100) }}{{ outil.description|length > 100 ? '...' : '' }}
                        </p>

                        <div class="border-top pt-3 mt-3 d-flex justify-content-between align-items-center">
                            <span class="text-muted small">👤 Par {{ outil.proprietaire.prenom }}</span>
                            <a href="{{ path('app_outil_show', {'id': outil.id}) }}" class="btn btn-info btn-sm text-white fw-bold px-3">
                                Voir détails
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-muted bg-light text-center py-5 shadow-sm">
                    📦 Aucun outil disponible dans le catalogue pour le moment.
                </div>
            </div>
        {% endfor %}
    </div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.querySelectorAll('.filter-btn').forEach(button => {
        button.addEventListener('click', () => {
            // Style de sélection des boutons
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('btn-dark');
                btn.classList.add('btn-outline-dark');
            });
            button.classList.remove('btn-outline-dark');
            button.classList.add('btn-dark');

            const targetCat = button.getAttribute('data-category');

            // Filtrage dynamique des cartes
            document.querySelectorAll('.outil-card').forEach(card => {
                if (targetCat === 'all' || card.getAttribute('data-cat') === targetCat) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    });
</script>
{% endblock %}
