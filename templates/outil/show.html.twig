{% extends 'base.html.twig' %}

{% block title %}Détails de l'outil - Eco-Partage{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-10">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 text-dark m-0">🛠️ Fiche Outil : {{ outil.nom }}</h1>
            <a href="{{ path('app_outil_index') }}" class="btn btn-outline-secondary">
                ← Retour au catalogue
            </a>
        </div>

        <div class="card shadow-sm border-0 bg-white p-4 mb-4">
            <div class="row">
                <div class="col-md-4 text-center mb-3 mb-md-0">
                    {% if outil.image %}
                        <img src="{{ outil.image }}" alt="{{ outil.nom }}" class="img-fluid rounded img-thumbnail" style="max-height: 250px; object-fit: cover;">
                    {% else %}
                        <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
                            <span>Pas d'image disponible</span>
                        </div>
                    {% endif %}
                </div>

                <div class="col-md-8">
                    <table class="table table-striped table-hover align-middle">
                        <tbody>
                            <tr>
                                <th style="width: 30%">Propriétaire</th>
                                <td>👤 {{ outil.proprietaire.prenom }} {{ outil.proprietaire.nom|upper }}</td>
                            </tr>
                            <tr>
                                <th>Catégorie</th>
                                <td>{{ outil.categorie }}</td>
                            </tr>
                            <tr>
                                <th>État</th>
                                <td>
                                    <span class="badge bg-secondary">
                                        {{ outil.etat }}
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th>Description</th>
                                <td>{{ outil.description }}</td>
                            </tr>
                        </tbody>
                    </table>

                    {# 🔒 BLOC ACTIONS SOCLE SECURISE (Appel du fragment réutilisable) #}
                    <div class="card bg-light border-0 mt-4">
                        <div class="card-body d-flex align-items-center justify-content-between p-3">
                            {{ include('outil/_bouton_emprunt.html.twig', {'outil': outil}) }}
                        </div>
                    </div>

                </div>
            </div>
        </div>

        {# Options de modification #}
        {% if app.user and app.user == outil.proprietaire %}
            <div class="card border-warning bg-light p-3 mt-5">
                <h5 class="card-title h6 text-warning-emphasis mb-3">Options du propriétaire</h5>
                <div class="d-flex gap-2">
                    <a href="{{ path('app_outil_edit', {'id': outil.id}) }}" class="btn btn-outline-warning btn-sm">
                        Modifier la fiche
                    </a>
                </div>
            </div>
        {% endif %}

    </div>
</div>

<hr class="my-5">

    {# 💬 Section des Avis & Commentaires #}
    <div class="row mb-5">
        <div class="col-12 col-lg-8 mx-auto">
            <h3 class="h4 fw-bold text-dark mb-4">💬 Avis des utilisateurs</h3>

            {% set aDesAvis = false %}

            <div class="d-flex flex-column gap-3">
                {% for historique in outil.historiques %}
                    {# On n'affiche que les lignes d'historique closes qui possèdent une note ou un commentaire #}
                    {% if historique.dateFin is not null and (historique.note is not null or historique.commentaire is not null) %}
                        {% set aDesAvis = true %}

                        <div class="card border-0 shadow-sm bg-light p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
                                <div>
                                    <strong class="text-dark">{{ historique.user.prenom }}</strong>
                                    <span class="text-muted small ms-2">le {{ historique.dateFin|date('d/m/Y') }}</span>
                                </div>

                                {# Étoiles de l'avis #}
                                {% if historique.note is not null %}
                                    <span class="text-warning small">
                                        {% for i in 1..historique.note %}
                                            <i class="fa-solid fa-star"></i>
                                        {% endfor %}
                                        {% if historique.note < 5 %}
                                            {% for i in (historique.note + 1)..5 %}
                                                <i class="fa-regular fa-star text-muted opacity-50"></i>
                                            {% endfor %}
                                        {% endif %}
                                    </span>
                                {% endif %}
                            </div>

                            <p class="card-text text-secondary mb-0 italic">
                                {% if historique.commentaire is not empty %}
                                    " {{ historique.commentaire }} "
                                </p>
                                {% else %}
                                    <span class="text-muted small">L'utilisateur a laissé une note mais aucun commentaire écrit.</span>
                                {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}

                {# Si l'outil n'a aucun avis enregistré #}
                {% if not aDesAvis %}
                    <div class="alert alert-light text-center border py-4 mb-0">
                        <span class="text-muted">📦 Aucun commentaire n'a encore été laissé pour cet outil. Soyez le premier à donner votre avis après l'avoir emprunté !</span>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
