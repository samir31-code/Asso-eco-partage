{% extends 'base.html.twig' %}

{% block title %}Détails de l'outil - Eco-Partage{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-10">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 text-dark m-0">🛠️ Fiche Outil : {{ outil.nom }}</h1>
            <a href="{{ path('app_outil_index') }}" class="btn btn-outline-secondary">
                ← Retour au catalogue
            </a>
        </div>

        <div class="card shadow-sm border-0 bg-white p-4 mb-4">
            <div class="row">
                <div class="col-md-4 text-center mb-3 mb-md-0">
                    {% if outil.image %}
                        <img src="{{ outil.image }}" alt="{{ outil.nom }}" class="img-fluid rounded img-thumbnail" style="max-height: 250px; object-fit: cover;">
                    {% else %}
                        <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
                            <span>Pas d'image disponible</span>
                        </div>
                    {% endif %}
                </div>

                <div class="col-md-8">
                    <table class="table table-striped table-hover align-middle">
                        <tbody>
                            <tr>
                                <th style="width: 30%">Propriétaire</th>
                                <td>👤 {{ outil.proprietaire.prenom }} {{ outil.proprietaire.nom|upper }}</td>
                            </tr>
                            <tr>
                                <th>Catégorie</th>
                                <td>{{ outil.categorie }}</td>
                            </tr>
                            <tr>
                                <th>État</th>
                                <td>
                                    <span class="badge bg-secondary">
                                        {{ outil.etat }}
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th>Description</th>
                                <td>{{ outil.description }}</td>
                            </tr>
                        </tbody>
                    </table>

                    {# 🔒 BLOC ACTIONS SOCLE SECURISE #}
                    <div class="card bg-light border-0 mt-4">
                        <div class="card-body d-flex align-items-center justify-content-between p-3">

                            {% if not is_granted('ROLE_MEMBRE') %}
                                <div class="text-muted small me-2">
                                    ⚠️ L'emprunt est réservé aux membres ayant réglé leur cotisation annuelle.
                                </div>
                                <a href="{{ path('app_cotisation_paiement') }}" class="btn btn-warning fw-bold px-4 text-dark">
                                    💳 Cotiser (15,00 €)
                                </a>
                            {% else %}

                                {% if not outil.emprunteur and app.user != outil.proprietaire %}
                                    <div class="text-success fw-semibold">
                                        ✅ Cet outil est disponible à l'emprunt.
                                    </div>
                                    <form action="{{ path('app_outil_emprunter', {'id': outil.id}) }}" method="POST" class="m-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('emprunter' ~ outil.id) }}">
                                        <button type="submit" class="btn btn-success px-4">
                                            🔑 Emprunter cet outil
                                        </button>
                                    </form>

                                {% elseif outil.emprunteur == app.user %}
                                    <div class="text-primary fw-semibold">
                                        ℹ️ Vous avez actuellement cet outil.
                                    </div>
                                    <form action="{{ path('app_outil_rendre', {'id': outil.id}) }}" method="POST" class="m-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('rendre' ~ outil.id) }}">
                                        <button type="submit" class="btn btn-warning text-dark fw-bold px-4">
                                            📦 Rendre l'outil
                                        </button>
                                    </form>

                                {% elseif outil.emprunteur %}
                                    <div class="text-danger fw-semibold">
                                        ❌ Indisponible : Emprunté par {{ outil.emprunteur.prenom }}.
                                    </div>
                                    <button class="btn btn-secondary px-4" disabled>Indisponible</button>

                                {% elseif app.user == outil.proprietaire %}
                                    <div class="text-muted small">
                                        🛠️ C'est votre outil.
                                    </div>
                                    <button class="btn btn-secondary px-4" disabled>Mon outil</button>
                                {% endif %}

                            {% endif %}
                        </div>
                    </div>

                </div>
            </div>
        </div>

        {# Options de modification #}
        {% if app.user and app.user == outil.proprietaire %}
            <div class="card border-warning bg-light p-3 mt-5">
                <h5 class="card-title h6 text-warning-emphasis mb-3">Options du propriétaire</h5>
                <div class="d-flex gap-2">
                    <a href="{{ path('app_outil_edit', {'id': outil.id}) }}" class="btn btn-outline-warning btn-sm">
                        Modifier la fiche
                    </a>
                </div>
            </div>
        {% endif %}

    </div>
</div>
{% endblock %}
