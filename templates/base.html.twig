<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

		{% block stylesheets %}
			{# 🚀 Le lien magique qui va chercher Bootstrap instantanément en ligne #}
			<link
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

			{# 🌟 Importation indispensable de FontAwesome pour afficher les étoiles #}
			<link
			rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

			{# 📦 Ton style personnalisé #}
			<link rel="stylesheet" href="{{ asset('styles/app.css') }}">
		{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}

		{% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
		{% if frankenphpHotReload %}
			<meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
			<script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
			<script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
		{% endif %}
	</head>
	<body>
		{# 🎨 Nouvelle Navbar entièrement stylisée avec Bootstrap #}
		<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 py-3">
			<div
				class="container-fluid">
				{# Logo #}
				<a class="navbar-brand text-info fw-bold fs-4" href="{{ path('app_home') }}">🌱 Eco-Partage</a>

				<div
					class="ms-auto d-flex align-items-center gap-3">
					{# 🔄 SI L'UTILISATEUR EST CONNECTÉ #}
					{% if app.user %}
						<a href="{{ path('app_outil_index') }}" class="text-white text-decoration-none me-3">📦 Catalogue</a>
						{# 👤 Nouveau lien vers l'Espace Profil #}
						<a href="{{ path('app_profil') }}" class="text-white text-decoration-none me-3">👤 Mon Profil</a>
						<span class="text-success fw-semibold me-2">Bonjour,
							{{ user.prenom ?? app.user.prenom }}</span>
						<a href="{{ path('app_logout') }}" class="btn btn-danger btn-sm px-3">Déconnexion</a>

						{# 🔄 SI L'UTILISATEUR N'EST PAS CONNECTÉ #}
					{% else %}
						<a href="{{ path('app_login') }}" class="text-white text-decoration-none me-2">Connexion</a>
						<a href="{{ path('app_register') }}" class="btn btn-success btn-sm px-3">S'inscrire</a>
					{% endif %}
				</div>
			</div>
		</nav>

		{# Conteneur principal pour centrer le contenu des pages #}
		<div
			class="container mt-4">

			{# 🔔 Affichage dynamique des alertes flash (Succès, Danger...) #}
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} alert-dismissible fade show shadow-sm" role="alert">
						{{ message }}
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
					</div>
				{% endfor %}
			{% endfor %}

			{% block body %}{% endblock %}
		</div>

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
	</body>
</html>
