{% extends 'base.html.twig' %}

{% block title %}Paiement Annulé - Eco-Partage{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-8 text-center">
        <div class="card shadow-sm border-0 bg-light p-5">
            <div class="card-body">
                {# Icône d'avertissement #}
                <div class="text-danger mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-exclamation-triangle-fill d-inline-block" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                    </svg>
                </div>

                <h1 class="card-title h2 text-dark mb-3">Paiement interrompu</h1>
                <p class="card-text text-muted fs-5 mb-4">
                    Le processus de paiement a été annulé. Aucune somme n'a été prélevée sur votre compte.
                </p>

                <div class="d-grid gap-2 d-md-block">
                    <a href="{{ path('app_cotisation_paiement') }}" class="btn btn-warning btn-lg px-4 gap-3 text-dark fw-bold">
                        🔄 Réessayer le paiement
                    </a>
                    <a href="{{ path('app_home') }}" class="btn btn-outline-secondary btn-lg px-4">
                        Retour à l'accueil
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
