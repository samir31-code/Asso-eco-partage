{% extends 'base.html.twig' %}

{% block title %}Paiement Annulé - Eco-Partage{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-8 text-center">
        <div class="card shadow-sm border-0 bg-light p-5">
            <div class="card-body">
                {# Icône d'annulation (Croix Rouge) #}
                <div class="text-danger mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-x-circle-fill d-inline-block" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293z"/>
                    </svg>
                </div>

                <h1 class="card-title h2 text-dark mb-3">Paiement annulé</h1>
                <p class="card-text text-muted fs-5 mb-4">
                    Le processus de paiement de votre cotisation a été interrompu. Aucun débit n'a été effectué.
                </p>

                <div class="d-grid gap-2 d-md-block">
                    <a href="{{ path('app_cotisation_paiement') }}" class="btn btn-danger btn-lg px-4 gap-3">
                        🔄 Réessayer le paiement
                    </a>
                    <a href="{{ path('app_profil') }}" class="btn btn-outline-secondary btn-lg px-4">
                        Retour au profil
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
