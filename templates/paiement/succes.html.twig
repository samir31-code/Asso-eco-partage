{% extends 'base.html.twig' %}

{% block title %}Paiement Réussi - Eco-Partage
{% endblock %}

{% block body %}
	<div class="row justify-content-center mt-5">
		<div class="col-md-8 text-center">
			<div class="card shadow-sm border-0 bg-light p-5">
				<div
					class="card-body">
					{# Icône de succès #}
					<div class="text-success mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-check-circle-fill d-inline-block" viewbox="0 0 16 16">
							<path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
						</svg>
					</div>

					<h1 class="card-title h2 text-dark mb-3">Merci pour votre règlement !</h1>
					<p class="card-text text-muted fs-5 mb-4">
						Votre paiement a été validé avec succès. Votre cotisation pour l'association
						<strong>Eco-Partage</strong>
						est désormais à jour.
					</p>

					<div class="d-grid gap-2 d-md-block">
						<a href="{{ path('app_outil_index') }}" class="btn btn-primary btn-lg px-4 gap-3">
							📦 Accéder au catalogue d'outils
						</a>
						<a href="{{ path('app_profil') }}" class="btn btn-outline-primary btn-lg px-4">
							👤 Mon Profil
						</a>
						<a href="{{ path('app_home') }}" class="btn btn-outline-secondary btn-lg px-4">
							Retour à l'accueil
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
